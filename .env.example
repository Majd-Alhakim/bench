# Copy to .env for local dev only. In the app, secrets live in Windows Credential Manager.

# Provider: "subscription" (local Claude Code login) or "api"
BENCH_PROVIDER=subscription

# Only for the api provider
ANTHROPIC_API_KEY=

# Where agents, memory and org.yaml live
BENCH_WORKSPACE_DIR=./workspace

# Default models (override config/models.yaml)
BENCH_MODEL_FAST=claude-haiku-5-5
BENCH_MODEL_BALANCED=claude-sonnet-5-5
BENCH_MODEL_DEEP=claude-opus-5-5

# Later sprints (connectors)
GITHUB_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

LOG_LEVEL=info
