# Copy to .env for local dev only. In the app, secrets live in the OS keychain (Electron safeStorage).

# Provider: "subscription" (local Claude Code login) or "api"
EUCAS_PROVIDER=subscription

# Only for the api provider
ANTHROPIC_API_KEY=

# Where agents, memory and org.yaml live
EUCAS_WORKSPACE_DIR=./workspace

# Default models (override config/models.yaml)
EUCAS_MODEL_FAST=claude-haiku-5-5
EUCAS_MODEL_BALANCED=claude-sonnet-5-5
EUCAS_MODEL_DEEP=claude-opus-5-5

# Later sprints (connectors)
GITHUB_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

LOG_LEVEL=info
